{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-9", "destination": "/a-propos", "permanent": true },
    { "source": "/accueil", "destination": "/", "permanent": true },
    { "source": "/mentions-l%C3%A9gales", "destination": "/mentions-legales", "permanent": true },
    { "source": "/politique-de-confidentialit%C3%A9", "destination": "/mentions-legales#confidentialite", "permanent": true },
    { "source": "/politique-de-cookies", "destination": "/mentions-legales#cookies", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
